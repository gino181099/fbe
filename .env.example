# Copiar a .env.local (esta PC) y cargar las mismas tres en Vercel (Settings → Environment Variables).

# Base de Neon: la URL "pooled" (host con -pooler) del panel de Neon → Connect.
DATABASE_URL=''

# Clave única para entrar al ERP.
ACCESS_PASSWORD=''

# Firma de las sesiones: texto largo al azar (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
AUTH_SECRET=''

# Notificaciones del resumen diario de la agenda (Web Push). Generar el par con:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=''
VAPID_PRIVATE_KEY=''

# Lo manda Vercel al llamar el cron (/api/cron/resumen-agenda): texto largo al azar.
CRON_SECRET=''
