# No hace falta ningún .env: la configuración está en src/lib/config.ts.
# Solo para casos puntuales, copiar a .env.local y descomentar:

# Otra carpeta de datos de Postgres / backups (por defecto %USERPROFILE%\frabel-erp-datos\...)
# PG_DATA_DIR=''
# BACKUP_DIR=''
# PG_PORT=5433

# Copia única desde la base vieja de Neon (npm run db:copiar-neon)
# NEON_DATABASE_URL=''
