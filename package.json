{
  "name": "frabel-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/local.ts dev",
    "build": "next build",
    "start": "tsx scripts/local.ts start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "tsx scripts/db.ts start",
    "db:stop": "tsx scripts/db.ts stop",
    "db:status": "tsx scripts/db.ts status",
    "db:setup": "tsx scripts/db.ts start && drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:backup": "tsx scripts/datos.ts backup",
    "db:restore": "tsx scripts/datos.ts restore",
    "db:copiar-neon": "tsx --env-file-if-exists=.env.local scripts/datos.ts copiar-neon",
    "db:import-legacy": "tsx --env-file-if-exists=.env.local scripts/migrate-legacy.ts",
    "db:saldar-historico": "tsx --env-file-if-exists=.env.local scripts/saldar-historico.ts",
    "db:import-potenciales": "tsx --env-file-if-exists=.env.local scripts/import-potenciales.ts"
  },
  "dependencies": {
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
